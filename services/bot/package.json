{
	"name": "bot",
	"version": "2.4.3",
	"description": "Xernerx Bot Discord daemon for directory, stats, and guild synchronization",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"initialize": "node ../../.xernerx/cli/prepare-package.mjs --sync-only",
		"dev": "node --watch --import tsx src/main.ts",
		"build": "node ../../.xernerx/cli/prepare-package.mjs && tsc",
		"start": "node --import tsx src/main.ts"
	},
	"keywords": [],
	"author": "Xernerx Studios",
	"license": "SEE LICENSE IN LICENSE",
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"prettier": "^3.10.1",
		"tsc-watch": "^7.2.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@xernerx/commands": "^0.2.8",
		"@xernerx/framework": "^1.2.0",
		"@xernerx/lib": "workspace:*",
		"@xernerx/stats": "^1.0.14",
		"@xernerx/terminal": "^1.2.0",
		"discord.js": "^14.28.1",
		"mongoose": "^9.12.2",
		"next": "^16.4.6",
		"server-only": "^0.0.1",
		"tslib": "^2.9.1"
	}
}
