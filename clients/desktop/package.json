{
	"name": "desktop",
	"productName": "Xernerx App",
	"version": "2.6.1",
	"description": "Xernerx App",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"initialize": "node ../../.xernerx/cli/prepare-package.mjs --sync-only",
		"build": "node ../../.xernerx/cli/prepare-package.mjs && tsc",
		"dist": "pnpm build && electron-builder --publish never",
		"dev": "tsc && electron ."
	},
	"author": "Xernerx Studios",
	"license": "SEE LICENSE IN LICENSE",
	"packageManager": "pnpm@11.24.0",
	"dependencies": {
		"@xernerx/terminal": "^1.2.0",
		"electron-store": "^12.0.0",
		"electron-updater": "^6.8.11"
	},
	"devDependencies": {
		"electron": "45.2.1",
		"electron-builder": "^26.18.0",
		"typescript": "^6.0.3"
	},
	"build": {
		"nodeGypRebuild": false,
		"buildDependenciesFromSource": false,
		"asar": true,
		"npmRebuild": true,
		"appId": "Xernerx.Desktop.Client",
		"productName": "Xernerx App",
		"icon": "public/icon.png",
		"compression": "maximum",
		"extraResources": [
			{
				"from": "metadata.json",
				"to": "metadata.json"
			},
			{
				"from": "public/icon.ico",
				"to": "icon.ico"
			},
			{
				"from": "public/icon-blue.ico",
				"to": "icon-blue.ico"
			},
			{
				"from": "public/icon-cyan.ico",
				"to": "icon-cyan.ico"
			},
			{
				"from": "public/icon-green.ico",
				"to": "icon-green.ico"
			},
			{
				"from": "public/icon-gold.ico",
				"to": "icon-gold.ico"
			},
			{
				"from": "public/icon-orange.ico",
				"to": "icon-orange.ico"
			},
			{
				"from": "public/icon-red.ico",
				"to": "icon-red.ico"
			},
			{
				"from": "public/icon-pink.ico",
				"to": "icon-pink.ico"
			},
			{
				"from": "public/icon-white.ico",
				"to": "icon-white.ico"
			},
			{
				"from": "public/icon-black.ico",
				"to": "icon-black.ico"
			}
		],
		"publish": [
			{
				"provider": "github",
				"owner": "Xernerx",
				"repo": "suite",
				"releaseType": "release"
			}
		],
		"electronLanguages": [
			"en"
		],
		"directories": {
			"output": "release"
		},
		"win": {
			"target": "nsis",
			"icon": "public/icon.ico",
			"artifactName": "${productName}-${version}-setup.${ext}"
		},
		"mac": {
			"target": [
				{
					"target": "dmg",
					"arch": [
						"universal"
					]
				}
			],
			"artifactName": "${productName}-${version}-setup.${ext}"
		},
		"linux": {
			"target": "AppImage",
			"artifactName": "${productName}-${version}-setup.${ext}",
			"executableName": "xernerx-app"
		},
		"nsis": {
			"oneClick": false,
			"differentialPackage": true,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true,
			"runAfterFinish": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "Xernerx App",
			"installerIcon": "public/icon.ico",
			"uninstallerIcon": "public/icon.ico",
			"installerSidebar": "public/banner.bmp",
			"uninstallerSidebar": "public/banner.bmp"
		}
	}
}
