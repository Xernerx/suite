			"fallback": "ui-monospace, SFMono-Regular, Menlo, monospace",
			"weights": [400, 600, 700],
			"googleFontsUrl": "https://fonts.google.com/specimen/Cascadia+Code",
			"stylesheetUrl": "https://fonts.googleapis.com/css2?family=Cascadia+Code:wght@400..700&display=swap"
