{
	"name": "suite",
	"private": true,
	"type": "module",
	"description": "Xernerx Suite",
	"version": "1.2.26",
	"author": "Xernerx Studios",
	"packageManager": "pnpm@11.17.0",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"generate:locales": "tsx packages/lib/src/scripts/generate-locales.ts",
		"predev": "pnpm i && pnpm generate:locales",
		"dev": "pnpm predev && concurrently -n apps,tunnel -c blue,green \"pnpm --parallel --filter ./apps/* dev\" \"pnpm tunnel\"",
		"prebuild": "pnpm generate:locales",
		"build": "pnpm --filter ./apps/* build",
		"lint": "pnpm --recursive run lint",
		"tunnel": "cloudflared tunnel run",
		"commit": "changeset",
		"push": "pnpm changeset version && git add . && git commit -m \"chore: release\" && pnpm changeset tag && git push --follow-tags"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"concurrently": "^9.2.1",
		"next": "^16",
		"shx": "^0.4.0",
		"tsx": "^4.19.0"
	}
}
